# ==============================================================================
# CẤU HÌNH MÔI TRƯỜNG BACKEND HOURGLASS (.env.example)
# Sao chép file này thành `.env` tại thư mục `backend/` trước khi khởi chạy.
# ==============================================================================

# 1. Chuỗi kết nối cơ sở dữ liệu (MySQL hoặc SQLite):
# Ví dụ với MySQL:
DATABASE_URL=mysql+pymysql://root:060207@127.0.0.1:3306/project_fastapi
# Hoặc sử dụng SQLite phục vụ phát triển / kiểm thử nhanh:
# DATABASE_URL=sqlite:///./hourglass.db

# 2. Khóa bí mật dùng để ký JWT Access Token & Refresh Token:
SECRET_KEY=hourglass-super-secret-jwt-key-2026
