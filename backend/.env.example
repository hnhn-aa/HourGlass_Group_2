# ==============================================================================
# CẤU HÌNH MÔI TRƯỜNG BACKEND HOURGLASS (.env.example)
# Sao chép file này thành `.env` tại thư mục `backend/` trước khi khởi chạy.
# ==============================================================================

# 1. Chuỗi kết nối cơ sở dữ liệu
# Lưu ý: đường dẫn SQLite tương đối (sqlite:///./hourglass.db) luôn được hiểu là
# backend/hourglass.db, bất kể chạy uvicorn từ thư mục nào.
# Mặc định: SQLite – chạy được ngay, không cần cài thêm dịch vụ (bảng + dữ liệu mẫu tự tạo khi khởi động).
DATABASE_URL=sqlite:///./hourglass.db
# Muốn dùng MySQL: tạo database trước rồi thay dòng trên bằng (điền mật khẩu MySQL của BẠN):
# DATABASE_URL=mysql+pymysql://root:<mat_khau_mysql>@127.0.0.1:3306/project_fastapi

# 2. Khóa bí mật dùng để ký JWT Access Token & Refresh Token.
# Giá trị dưới đây chỉ dùng khi chạy local. Khi deploy PHẢI đổi thành chuỗi ngẫu nhiên, ví dụ tạo bằng:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=doi-chuoi-nay-khi-deploy-hourglass-dev-key

# 3. CORS – các tên miền Frontend được phép gọi API (phân tách bằng dấu phẩy).
# Để trống hoặc "*" = cho phép mọi origin (chỉ nên dùng khi phát triển local).
# localhost / 127.0.0.1 ở MỌI cổng (Live Server :5500, :3000, :5173, :8080...) luôn được phép,
# kể cả khi đã khai báo CORS_ORIGINS bên dưới.
# CORS_ORIGINS=https://hourglass.vercel.app,http://127.0.0.1:5500
# Tùy chọn: biểu thức chính quy cho các bản Preview của Vercel
# CORS_ORIGIN_REGEX=https://hourglass-.*\.vercel\.app

# 4. Trợ lý AI (HourGlass AI Assistant – POST /api/ai/chat)
# Để trống AI_API_KEY = trợ lý vẫn hoạt động bằng chế độ trả lời theo kịch bản HourGlass.
# - Gemini: lấy khóa tại Google AI Studio (khóa dạng "AIza..." → tự nhận diện provider gemini).
# - OpenAI hoặc dịch vụ tương thích OpenAI (Groq, OpenRouter, Ollama...): đặt AI_PROVIDER=openai
#   và AI_BASE_URL tương ứng (VD Groq: https://api.groq.com/openai/v1).
# ⚠ KHÔNG điền khóa thật vào file .env.example (file này được chia sẻ công khai) – chỉ điền trong .env.
AI_API_KEY=
# AI_PROVIDER=auto              # auto | gemini | openai
# AI_MODEL=gemini-2.5-flash     # mặc định: gemini-2.5-flash (gemini) / gpt-4o-mini (openai)
# AI_BASE_URL=                  # để trống = endpoint mặc định của provider
# AI_TIMEOUT=20                 # số giây chờ phản hồi; quá thời gian sẽ chuyển sang chế độ dự phòng
# AI_TEMPERATURE=0.6
# AI_MAX_OUTPUT_TOKENS=800
